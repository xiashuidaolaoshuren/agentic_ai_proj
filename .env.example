# Copy to `.env` and fill in values locally. Never commit real secrets.

# --- OpenAI-compatible LLM (live summarization and optional chat follow-ups) ---
OPENAI_API_KEY=
# Optional: default is provider-specific; set for local gateways or Azure-style endpoints.
OPENAI_BASE_URL=
# Optional: chat model name for summarization (defaults to gpt-4o-mini in code).
OPENAI_MODEL=

# --- GitHub API (connector; optional token for higher rate limits) ---
GITHUB_TOKEN=

# --- Hugging Face Hub (optional token for higher rate limits) ---
# HUGGINGFACE_TOKEN=hf_your_token

# --- Zhihu Developer Platform (required for live practitioner search) ---
# Access Secret from https://developer.zhihu.com — sent as Bearer token.
# ZHIHU_ACCESS_SECRET=your_zhihu_access_secret

# --- Bilibili (optional; reduces HTTP 412 anti-bot blocks) ---
# Copy from browser cookies at bilibili.com (DevTools → Application → Cookies).
# Channel/uploader feeds usually need all three values.
# BILIBILI_SESSDATA=your_sessdata
# BILIBILI_BILI_JCT=your_bili_jct
# BILIBILI_BUVID3=your_buvid3
#
# Network tuning when cookies are set but requests still return HTTP 412 / HTML challenge:
# BILIBILI_HTTP_CLIENT=curl_cffi
# BILIBILI_IMPERSONATE=chrome131
# BILIBILI_PROXY_URL=http://127.0.0.1:7890
# BILIBILI_TIMEOUT_SECONDS=30

# --- Logging (optional) ---
# AI_NEWS_AGENT_LOG_LEVEL=INFO
# AI_NEWS_AGENT_LOG_PATH=logs/ai-news-agent.log
# AI_NEWS_AGENT_LOG_MAX_BYTES=2000000
# AI_NEWS_AGENT_LOG_BACKUP_COUNT=3

# --- Optional overrides ---
# Planned / storage overrides may be wired in future milestones.
# AI_NEWS_AGENT_DATABASE_PATH=.data/digest.db
